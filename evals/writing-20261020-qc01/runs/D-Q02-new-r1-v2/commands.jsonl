hashes_verified\u0027:len(inputs),\u0027required_files_present\u0027:len(required),\u0027checker_view_bodies_identical\u0027:True,\u0027final_body_words\u0027:counts[\u0027body_words\u0027],\u0027attribution_heading_words\u0027:counts[\u0027attribution_heading_words\u0027],\u0027recorded_process_exit_codes_all_zero\u0027:True,\u0027note\u0027:\u0027Manifest-orchestration warnings were repaired and documented in self-review.md; checker stdout was retained.\u0027}\n(out/\u0027validation.json\u0027).write_text(json.dumps(result,ensure_ascii=False,indent=2)+\u0027\\n\u0027,encoding=\u0027utf-8\u0027)\nprint(json.dumps(result,ensure_ascii=False,indent=2))"]}
